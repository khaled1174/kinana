{
  "name": "kinana-desktop",
  "version": "0.4.0-beta",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:e2e": "npm run typecheck && vite build --mode e2e",
    "tauri": "tauri",
    "test:ui": "wdio run ./wdio.conf.mjs",
    "test:classification": "wdio run ./wdio.classification.conf.mjs",
    "test:scan-review": "wdio run ./wdio.scan-review.conf.mjs",
    "test:release-isolation": "node tests/release-isolation.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:native:e2e": "node scripts/build-native.mjs e2e",
    "test:unit": "node --experimental-strip-types --test tests/presentation.test.mjs tests/paths-reasons.test.mjs tests/scan-plan.test.mjs tests/classification-report.test.mjs tests/batch-review.test.mjs tests/taxonomy-draft.test.mjs tests/audit-rules.test.mjs tests/audit-groups.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "radix-ui": "1.8.1",
    "cn": "0.5.2",
    "lucide-react": "1.73.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.5",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "webdriverio": "9.33.1",
    "@wdio/cli": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/spec-reporter": "9.33.1",
    "@wdio/tauri-service": "1.5.1",
    "@wdio/tauri-plugin": "1.5.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "overrides": {
    "cn": "$cn"
  },
  "license": "MIT"
}
