{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kinana",
  "version": "0.3.0",
  "identifier": "io.github.khaled1174.kinana",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kinana",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
